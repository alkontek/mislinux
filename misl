misl_help() {
  cat <<EOF
MIS Linux $MISL_VERSION bootstrap
usage: misl <command> [args]

  version              print bootstrap version and os-release identity
  bump minor|major|undo|X.Y rewrite VERSION + misl.conf (+ example)
  env [list|export]    print resolved site pins (export: shell assignments)
  os-release           print the composed /etc/os-release text
  help                 this text
  doctor               host qualification (Fedora 44)
  doctor pkgs          print Fedora 44 dnf install line
  doctor install       dnf install host deps (root, Fedora)
  disk plan            print partition/mount plan (no writes)
  disk apply           gates + plan only (policy A; does not format)
  sources fetch        refresh catalog, create \$MISL_SNAPSHOT, wget wget-list files
  sources refresh      replace snapshot wget-list + md5sums from \$MISL_MIRROR
  sources integrate [--reintegrate] <name>
                       host only: refresh catalog, fetch one package, stage
                       (prints chroot build next; does not compile)
  sources check        verify wget-list files against md5sums
  sources stage        hardlink verified files into \$LFS/usr/src/misl
  sources remote       HEAD-check \$MISL_MIRROR wget-list + md5sums (no download)
  integrate            alias for sources integrate
  prep                 chapter 4 layout + lfs user + env + grant \$LFS
  prep publish         also copy mislinux/ into ~lfs (not the tarball tree)
  build <recipe>       run a stages/* recipe (stage/name if ambiguous)
  build-stage <stage>  run every packages.manifest row for that stage
  logs [name]          tail recipe log (default: newest under \$LFS/var/lib/misl/logs)
  status               package graph + stamps
  config               print last chapter-9 config report
  config apply         re-run 09-config/systemd-config (MISL_FORCE=1)
  chroot prep          ch7 owner + virtfs + files + publish scripts into $LFS
  enter [--net]        chroot into $LFS as root (--net: host DNS for the session)
  net on|off|status    bind host resolv.conf into \$LFS (host only, not permanent)
  overlay list|status|apply|undo|install
                       named extras on the base tree (cloud, do, …)
  cloud apply          overlay apply cloud do (compat)
  cloud undo           overlay undo do then cloud
  cloud install        chroot: meson-install cloud-init (cloud overlay)
  cloud status         print \$LFS/var/lib/misl/cloud.report
  cloud sanitize       drop machine-id / ssh host keys / cloud-init seed
  cloud wheels         host: pip download deps into incoming/ (needs DNS)
  img pack             host root: pack \$LFS into a BIOS GPT .img
  img test             host qemu of that .img (--virtio default, --ide to compare)
  iso pack             host root: live ISO from a packed .img (--uefi default)
  iso test             host qemu of that .iso (--uefi default, --bios for SeaBIOS)
  iso test --inspect   mount ISO, unpack initramfs, list /init + libs (no qemu)
  iso inspect          same as iso test --inspect
  iso usb --list       USB disk nodes under /dev/disk/by-id/usb-* (no -part)
  iso usb ISO DISK     wipe that stick as GPT+ESP and copy a --uefi ISO
                       MISL_FORCE=1 ; example:
                       MISL_FORCE=1 ./misl iso usb FILE.iso /dev/disk/by-id/usb-SanDisk_Cruzer_Blade_...-0:0

Sources: $MISL_WGET_LIST
Snapshot: $MISL_SNAPSHOT
Mirror: $MISL_MIRROR
EOF
}

# Manifest column 2 is pkg_name (binutils). The file can be
# binutils-pass1.sh or libstdcxx.sh (pkg_name=libstdc++).
misl_recipe_in_stage() {
  local stage=$1 want=$2 f cand pname
  f=$MISL_ROOT/stages/$stage/${want}.sh
  [[ -f $f ]] && { printf '%s\n' "$f"; return 0; }
  for cand in "$MISL_ROOT/stages/$stage"/*.sh; do
    [[ -f $cand ]] || continue
    pname=$(awk -F= '/^pkg_name=/{gsub(/["\047]/,"",$2); print $2; exit}' "$cand")
    [[ $pname == "$want" ]] || continue
    printf '%s\n' "$cand"
    return 0
  done
  return 1
}

misl_build() {
  local name=${1:-} f
  [[ -n $name ]] || die "usage: misl build <recipe|stage/recipe>"
  case $name in
    05-cross/*|06-temp/*)
      if [[ ${EUID:-$(id -u)} -eq 0 && ${MISL_AS_LFS:-0} != 1 ]]; then
        misl_reexec_as_lfs build "$name"
      fi
      ;;
  esac
  if [[ $name == */* ]]; then
    f=$(misl_recipe_in_stage "${name%%/*}" "${name#*/}") \
      || die "no recipe $name"
  else
    local matches n
    matches=$(find "$MISL_ROOT/stages" -type f -name "${name}.sh" | sort)
    n=$(printf '%s\n' "$matches" | grep -c . || true)
    if (( n == 0 )); then
      die "no recipe named $name"
    elif (( n == 1 )); then
      f=$matches
    else
      # Bare name: only stages this uid may run. lfs stays in 05/06 so
      # `misl build glibc` after pass1 skips instead of jumping to 08.
      f=""
      local stage cand stamp pname ppass stages first
      first=""
      if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
        stages="07-chroot-temp 08-system 09-config 10-boot"
      else
        stages="05-cross 06-temp"
      fi
      for stage in $stages; do
        cand=$MISL_ROOT/stages/$stage/${name}.sh
        [[ -f $cand ]] || continue
        [[ -n $first ]] || first=$cand
        pname=$(awk -F= "/^pkg_name=/{gsub(/[\"\047]/,\"\",\$2); print \$2; exit}" "$cand")
        ppass=$(awk -F= "/^pkg_pass=/{gsub(/[\"\047]/,\"\",\$2); print \$2; exit}" "$cand")
        pname=${pname:-$name}
        ppass=${ppass:-1}
        stamp=${LFS:?}/var/lib/misl/stamps/${stage}-${pname}-${ppass}.done
        if [[ ! -f $stamp ]]; then
          f=$cand
          info "using $f (also: $(printf '%s' "$matches" | tr '\n' ' '))"
          break
        fi
      done
      [[ -n $f ]] || f=$first
      if [[ -z $f ]]; then
        die "no $name recipe for this user; use stage/name (found: $(printf '%s' "$matches" | tr '\n' ' '))"
      fi
    fi
  fi
  recipe_reset
  # shellcheck disable=SC1090
  . "$f"
  recipe_main
}


misl_logs() {
  require_lfs_set
  local dir name f
  dir=$(misl_lfs_join var/lib/misl/logs)
  name=${1:-}
  if [[ -n $name ]]; then
    f=$(ls -1t "$dir"/*"${name}"* 2>/dev/null | head -1 || true)
  else
    f=$(ls -1t "$dir"/*.log 2>/dev/null | head -1 || true)
  fi
  [[ -n $f && -f $f ]] || die "no log in $dir"
  info "log $f"
  tail -n 80 "$f"
}

misl_build_stage() {
  local stage=${1:-} line name
  [[ -n $stage ]] || die "usage: misl build-stage <05-cross|06-temp|07-chroot-temp|08-system|09-config|10-boot>"
  require_lfs_set
  case $stage in
    05-cross|06-temp)
      if [[ ${EUID:-$(id -u)} -eq 0 && ${MISL_AS_LFS:-0} != 1 ]]; then
        misl_reexec_as_lfs build-stage "$stage"
      fi
      ;;
  esac
  while read -r line; do
    [[ $line == ${stage}\ * ]] || continue
    name=$(awk "{print \$2}" <<<"$line")
    info "stage $stage -> $name"
    misl_build "$stage/$name"
  done < "$MISL_ROOT/config/packages.manifest"
}

cmd=${1:-help}
shift || true
case $cmd in
  bump) misl_bump "$@" ;;
  env) misl_env "${1:-list}" ;;
  version|-v|--version)
    printf 'MIS Linux %s\n' "$MISL_VERSION"
    printf 'NAME="%s" ID=%s VERSION_ID="%s" VARIANT="%s" VARIANT_ID=%s\n' \
      "$MISL_NAME" "$MISL_ID" "$MISL_VERSION_ID" "$MISL_VARIANT" "$MISL_VARIANT_ID"
    printf 'PRETTY_NAME="%s"\n' "$MISL_PRETTY_NAME"
    printf 'DIST_VERSION=%s DIST_CODENAME=%s\n' "$MISL_DIST_VERSION" "$MISL_DIST_CODENAME"
    if [[ -n ${LFS:-} ]]; then
      names=$(misl_overlay_active_qnames 2>/dev/null | tr '\n' ' ')
      names=${names%% }
      [[ -n $names ]] && printf 'MISL_OVERLAYS="%s"\n' "$names"
    fi
    ;;
  os-release) misl_os_release_text ;;
  help|-h|--help) misl_help ;;
  doctor)
    sub=${1:-check}; shift || true
    case $sub in
      check|"") misl_doctor ;;
      pkgs|packages) misl_doctor_pkgs ;;
      install) misl_doctor_install ;;
      *) die "usage: misl doctor [check|pkgs|install]" ;;
    esac
    ;;
  disk)
    sub=${1:-plan}; shift || true
    case $sub in
      plan) misl_disk_plan ;;
      apply) misl_disk_apply ;;
      *) die "usage: misl disk plan|apply" ;;
    esac
    ;;
  sources)
    sub=${1:-check}; shift || true
    case $sub in
      check) misl_sources_check ;;
      stage) misl_sources_stage ;;
      fetch) misl_sources_fetch ;;
      refresh) misl_catalog_refresh ;;
      integrate) misl_sources_integrate "$@" ;;
      remote) misl_sources_remote ;;
      *) die "usage: misl sources check|stage|fetch|refresh|integrate|remote" ;;
    esac
    ;;
  prep) misl_prep "${1:-}" ;;
  build) misl_build "${1:-}" ;;
  build-stage) misl_build_stage "${1:-}" ;;
  integrate) misl_sources_integrate "$@" ;;
  status) misl_status ;;
  config)
    sub=${1:-show}
    case $sub in
      show|"")
        f=$(misl_lfs_join var/lib/misl/09-config.report)
        if [[ -f $f ]]; then
          cat "$f"
        else
          die "no 09-config report at $f — run: MISL_FORCE=1 ./misl build 09-config/systemd-config"
        fi
        ;;
      apply)
        MISL_FORCE=1 misl_build 09-config/systemd-config
        ;;
      *) die "usage: misl config [show|apply]" ;;
    esac
    ;;
  logs) misl_logs "${1:-}" ;;
  chroot)
    sub=${1:-enter}; shift || true
    case $sub in
      prep) misl_chroot_prep ;;
      enter|"") misl_enter "$@" ;;
      mounts) misl_kernfs_mount ;;
      *) die "usage: misl chroot [prep|enter|mounts]" ;;
    esac
    ;;
  enter) misl_enter "$@" ;;
  net) misl_net "$@" ;;
  overlay|overlays) misl_overlay "$@" ;;
  cloud) misl_cloud "$@" ;;
  img|image) misl_img "$@" ;;
  iso) misl_iso "$@" ;;
  *) die "unknown command: $cmd (try: misl help)" ;;
esac
