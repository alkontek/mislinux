# misl overlay desktop/asus/rog-strix-x570: AX200 (iwlwifi).
# Needs wpa_supplicant@<iface>.service; see
# /usr/share/doc/misl/desktop/README. Before desktop's 30-wireless.
[Match]
Driver=iwlwifi

[Link]
RequiredForOnline=no

[Network]
DHCP=yes
IgnoreCarrierLoss=3s

[DHCPv4]
UseDomains=true
RouteMetric=600
